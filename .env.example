# Copy this file to .env.local and fill in your keys. NEVER commit .env.local.
# All three have free tiers — see README.md for how to get each key.

# Lawyers (Prosecutor + Defender) — both use the same Groq model
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Fallback for the lawyers when Groq fails or is rate-limited (optional but recommended)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Judge + "Ask the Judge" chatbot (fallback: Groq)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
